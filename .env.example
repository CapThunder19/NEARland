# Copy to .env.local and fill in. Never commit .env.local.

# NEAR network the game connects to: testnet (default) or mainnet
NEXT_PUBLIC_NEAR_NETWORK=testnet

# Supabase (persistence). Anon key is public; the service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only needed by scripts/*.sh (direct Postgres connection string)
DATABASE_URL=

# NEAR market contract (see contract/) and the game-server account allowed to mint
NEXT_PUBLIC_NEAR_CONTRACT_ID=
NEAR_GAME_ACCOUNT_ID=
NEAR_GAME_PRIVATE_KEY=

# Random string, at least 32 chars, used to sign session tokens
NEARLAND_SESSION_SECRET=
